# ==========================================
# VARUNA AI — Environment Configuration Template
# Copy this file to .env and supply actual values for your deployment
# NEVER commit real production secrets to git!
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Secret Keys (Generate with `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./varuna.db
# For PostgreSQL in Production:
# DATABASE_URL=postgresql://varuna_admin:your_db_password@localhost:5432/varuna_prod

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Razorpay (India First Payment Gateway)
# Obtain test credentials from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# AI Providers
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_PROVIDER=simulator

# Credit & Cost Controls
CREDIT_VALUE_INR=0.10
SIGNUP_FREE_CREDITS=100.0
MAX_RESERVATION_CREDITS=50.0
DAILY_ORG_SPENDING_CAP_CREDITS=5000.0
GLOBAL_AI_KILL_SWITCH=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
